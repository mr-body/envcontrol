{
  "name": "envcontrol",
  "version": "1.0.0",
  "description": "CLI do ESP32 EnvControl (serial e TCP)",
  "type": "module",
  "main": "dist/index.js",
  "module": "index.ts",
  "private": false,
  "bin": {
    "envcontrol": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "ports": "bun run index.ts ports",
    "shell": "bun run index.ts shell",
    "dev": "bun run index.ts",
    "build": "bun build index.ts --target=node --external serialport --external @serialport/* --outfile=dist/index.js",
    "compile": "bun build --compile index.ts --outfile envcontrol.exe",
    "prepack": "npm run build",
    "pack": "npm pack",
    "release": "npm publish"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  }
}