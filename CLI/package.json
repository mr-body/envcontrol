{
  "name": "envcontrol",
  "module": "index.ts",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "bin": {
    "envcontrol": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run dist/index.js",
    "ports": "bun run index.ts ports",
    "shell": "bun run index.ts shell",
    "dev": "bun run index.ts",
    "build": "bun build index.ts --target=node --outfile=dist/index.js",
    "compling": "bun build --compile index.ts --outfile envcontrol.exe",
    "prepack": "npm run",
    "pack": "npm pack",
    "prepublishOnly": "npm run build",
    "release": "npm publish"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  }
}